<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >

  <include>QFontDatabase</include>
  <include>QFont</include>

  <kcfgfile name="kirifluxrc" />
  <group name="General">
    <entry name="ApiUrl" type="String">
      <label>Miniflux API URL</label>
      <default></default>
    </entry>
    <entry name="ApiKey" type="Password">
      <label>Miniflux API Key</label>
      <default></default>
    </entry>
    <entry name="SyncInterval" type="Int">
      <label>Sync Interval (minutes)</label>
      <default>30</default>
      <min>1</min>
      <max>1440</max>
    </entry>
    <entry name="ShowToolbarLabels" type="Bool">
      <label>Show labels in toolbars</label>
      <default>false</default>
    </entry>
    <entry name="LastSyncTime" type="DateTime">
      <label>Last Synchronized Time</label>
    </entry>
    <entry name="CleanSync" type="Bool">
      <label>Clean Sync (Reset local state on sync, no server updates)</label>
      <default>false</default>
    </entry>
    <entry name="FilterMode" type="String">
      <label>Last selected filter mode (all, unread, starred)</label>
      <default>all</default>
    </entry>
    <entry name="TitleLines" type="Int">
      <label>Maximum number of lines for article titles</label>
      <default>2</default>
      <min>1</min>
      <max>3</max>
    </entry>
    <entry name="LeftPaneWidth" type="Int">
      <label>Width of the left (feeds) pane</label>
      <default>250</default>
      <min>100</min>
      <max>600</max>
    </entry>
    <entry name="CenterPaneWidth" type="Int">
      <label>Width of the center (article list) pane</label>
      <default>450</default>
      <min>200</min>
      <max>1000</max>
    </entry>
    <entry name="PreFetchImages" type="Bool">
      <label>Pre-fetch images of recent articles in the background</label>
      <default>true</default>
    </entry>
    <entry name="CacheSizeMB" type="Int">
      <label>Maximum size of the image cache in MB</label>
      <default>512</default>
      <min>32</min>
      <max>4096</max>
    </entry>
    <entry name="LazyLoadingEnabled" type="Bool">
      <label>Load articles in batches while scrolling to save memory</label>
      <default>true</default>
    </entry>
    <entry name="LazyLoadingBatchSize" type="Int">
      <label>Number of articles to load per batch</label>
      <default>50</default>
      <min>10</min>
      <max>500</max>
    </entry>
    <entry name="AutoPruneEnabled" type="Bool">
      <label>Automatically prune old read articles and vacuum database</label>
      <default>true</default>
    </entry>
    <entry name="PruneAfterDays" type="Int">
      <label>Number of days to keep read articles before deleting</label>
      <default>7</default>
    </entry>
    <entry name="LastVacuumDate" type="DateTime">
      <label>Last time the database was vacuumed</label>
    </entry>
  </group>
  <group name="Reading">
    <entry name="MarkAsReadOnOpen" type="Bool">
      <label>Mark article as read when opened</label>
      <default>false</default>
    </entry>
    <entry name="MarkAsReadOnScroll" type="Bool">
      <label>Mark article as read when scrolled past top</label>
      <default>false</default>
    </entry>
    <entry name="UseReaderMode" type="Bool">
      <label>Use native Qt Text instead of Chromium WebView</label>
      <default>false</default>
    </entry>
    <entry name="CloseReadingPaneOnReset" type="Bool">
      <label>Close reading pane when switching filters or feeds</label>
      <default>false</default>
    </entry>
  </group>
  <group name="Fonts">
    <entry name="LeftPaneFont" type="Font">
      <label>Font for left pane (category/feed list)</label>
      <default code="true">QFontDatabase::systemFont(QFontDatabase::GeneralFont)</default>
    </entry>
    <entry name="ArticleListTitleFont" type="Font">
      <label>Font for article list titles</label>
      <default code="true">[]() { QFont f = QFontDatabase::systemFont(QFontDatabase::GeneralFont); f.setBold(true); return f; }()</default>
    </entry>
    <entry name="ArticleListInfoFont" type="Font">
      <label>Font for article list info (author/date)</label>
      <default code="true">[]() { QFont f = QFontDatabase::systemFont(QFontDatabase::GeneralFont); f.setPixelSize(11); return f; }()</default>
    </entry>
    <entry name="ArticleViewTitleFont" type="Font">
      <label>Font for article view title</label>
      <default code="true">[]() { QFont f = QFontDatabase::systemFont(QFontDatabase::GeneralFont); f.setBold(true); if (f.pointSizeF() > 0) f.setPointSizeF(f.pointSizeF() * 2.5); else f.setPixelSize(f.pixelSize() > 0 ? qRound(f.pixelSize() * 2.5) : 24); return f; }()</default>
    </entry>
    <entry name="ArticleViewInfoFont" type="Font">
      <label>Font for article view info</label>
      <default code="true">[]() { QFont f = QFontDatabase::systemFont(QFontDatabase::GeneralFont); if (f.pointSizeF() > 0) f.setPointSizeF(f.pointSizeF() * 0.9); else f.setPixelSize(f.pixelSize() > 0 ? qRound(f.pixelSize() * 0.9) : 11); return f; }()</default>
    </entry>
    <entry name="ArticleViewTextFont" type="Font">
      <label>Font for article view body</label>
      <default code="true">[]() { QFont f = QFontDatabase::systemFont(QFontDatabase::GeneralFont); f.setPixelSize(16); return f; }()</default>
    </entry>
  </group>
</kcfg>
